# Phase 2 (docs/plans/001-first-vertical-slice.md)
# Copy this file to .env and adjust values as needed.

POSTGRES_USER=tmip
POSTGRES_PASSWORD=tmip
POSTGRES_DB=tmip

DATABASE_URL=postgresql://tmip:tmip@localhost:5432/tmip
# Integration tests use a separate database and never clean the development database.
TEST_DATABASE_URL=postgresql://tmip:tmip@localhost:5432/tmip_test
# ── Media path namespaces (ADR-002 read-only storage, ADR-006 §9) ───────────
# Two DIFFERENT namespaces. Never mix them:
#
#   MEDIA_HOST_PATH  Host filesystem path. Used ONLY as the Docker Compose
#                    bind-mount source. Never read by the application.
#   MEDIA_ROOT       Container-visible path. Used by the api and ai-processor
#                    containers and by the application. Always /media in Docker.
#
# The mount is "${MEDIA_HOST_PATH}:/media:ro" (read-only — ADR-002).
# Storage.rootPath is also /media: it lives in the container namespace, so it
# must equal MEDIA_ROOT and never MEDIA_HOST_PATH.

# Host filesystem path used only by the Docker Compose bind mount.
# Development (Windows) example:
MEDIA_HOST_PATH=D:/DEVELOP/Media
# Server A deployment example (SMB/NFS mounted by the host OS):
#   Server B → SMB/NFS → Server A /mnt/tmip-media → Docker /media:ro
# MEDIA_HOST_PATH=/mnt/tmip-media

# Container-visible media path. Do NOT set this to a host filesystem path.
MEDIA_ROOT=/media
STORAGE_NAME=Server B Media
SUPPORTED_MEDIA_EXTENSIONS=.mp4,.mov,.mxf,.mpg,.mpeg,.avi,.mkv,.ts,.mts
METADATA_WORKER_CONCURRENCY=1
# Phase 12 bounded retry (WORKFLOWS.md §33, ADR-005). Only TRANSIENT failures
# (ffprobe timeout, temporary file access/storage/network problems) retry
# automatically; permanent failures never do. Set METADATA_MAX_RETRIES=0 to
# disable automatic retry entirely (restores Phase 1–11 behavior).
METADATA_MAX_RETRIES=2
# Base for exponential backoff between retries (ms): base * 2^(n-1), capped at 5000.
METADATA_RETRY_BACKOFF_MS=250

# Docker stack notes:
# - DATABASE_URL above (localhost) is used for host dev. Inside the compose
#   network it is OVERRIDDEN to the `postgres` service hostname by
#   docker-compose.yml, so the value above still applies to host runs only.
# - MEDIA_HOST_PATH is used ONLY by docker-compose.yml for the read-only bind
#   mount. It is a HOST path and is never passed to the application.
# - MEDIA_ROOT is the CONTAINER path (/media). It is set on the api and
#   ai-processor services and must match the bind-mount target.
# - The startup bootstrap requires Storage.rootPath to equal the
#   application-visible MEDIA_ROOT (Storage.name is unique and refuses to be
#   rewritten). In Docker this is always /media. Set it once via psql:
#     UPDATE "Storage" SET "rootPath" = '/media' WHERE name = '<STORAGE_NAME>';
# - Host dev (pnpm --filter @tmip/api dev) runs the app directly against the
#   host filesystem, so it needs MEDIA_ROOT to be the host path. That is a
#   DIFFERENT environment with a DIFFERENT value on purpose; do not point
#   host dev at the Docker database without updating Storage.rootPath to match.
#   Never make one MEDIA_ROOT value mean both a host path and /media.

# Browser API endpoint for the Next.js web application.
# EXACTLY ONE origin — never a comma-separated list. NEXT_PUBLIC_* variables are
# build-time/public: this value is inlined into the browser bundle at image build
# time and used verbatim as the fetch() base URL. A list such as
# "http://localhost:4000,http://10.0.0.5:4000" would therefore produce an invalid
# URL and break every browser request.
# Browsers on OTHER PCs must reach this address, so point it at this host's LAN
# IP (e.g. http://192.168.1.50:4000) rather than localhost.
# Changing it requires rebuilding the web image (docker compose build web).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Browser origin(s) allowed to call the API (CORS). Unlike NEXT_PUBLIC_API_URL
# this DOES accept a comma-separated allowlist, e.g.
# http://localhost:3000,http://192.168.1.50:3000
# Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000

# Absolute path to the ffprobe binary on the host. Optional: when unset, the
# adapter resolves "ffprobe" from PATH. Set this when ffprobe is installed in a
# non-PATH location (common for manual Windows installs).
# FFPROBE_PATH="C:/path/to/ffprobe.exe"

# In the api container FFPROBE_PATH=/usr/bin/ffprobe is set by docker-compose.yml.

# ---------------------------------------------------------------------------
# AI enrichment (Phase 14 — ADR-006, docs/plans/006-ai-processor-integration.md)
# Additive v2 capability. It does NOT change TMIP v1 scope or behavior; with
# AI_ENABLED unset the whole subsystem is inert and every media row simply stays
# aiStatus=PENDING ("not processed").
# ---------------------------------------------------------------------------

# Master switch. false by default: nothing runs until an operator enables it.
AI_ENABLED=false
# Internal Docker-network address of the ai-processor service. Set by
# docker-compose.yml; for host dev point it at the published port if you run the
# processor manually.
AI_PROCESSOR_URL=http://ai-processor:8000
# faster-whisper model size: tiny | base | small | medium | large-v3.
AI_MODEL_SIZE=medium
# ISO-639 language hint for transcription.
AI_LANGUAGE=id
# One AI job at a time. Media is read over the network and inference is
# CPU-bound; start conservatively (AGENTS.md §20).
AI_CONCURRENCY=1
# Bounded retry for TRANSIENT AI failures only (AGENTS.md §19, ADR-006 §6).
AI_MAX_RETRIES=2
# Base for exponential backoff between AI retries (ms): base * 2^(attempt-1).
AI_RETRY_BACKOFF_MS=5000
# Per-HTTP-request timeout to the processor (start/status; short calls).
AI_REQUEST_TIMEOUT_MS=30000
# Transcription status poll cadence.
AI_POLL_INTERVAL_MS=10000
# Ceiling for one synchronous stage call (OCR frame).
AI_STAGE_TIMEOUT_MS=900000
# Absolute ceiling for one AI job end-to-end (deadline exceeded ⇒ TRANSIENT).
AI_JOB_DEADLINE_MS=5400000

# ── LLM provider (ai-processor LLM stages: summary/keywords/classification,
#    and OCR presenter parsing) — ADR-006 §11 ────────────────────────────────
# Provider-generic: LLM_BASE_URL may be any OpenAI-compatible /chat/completions
# API (OpenRouter by default, or e.g. a self-hosted gateway). Precedence when
# both generic and legacy names are set: LLM_* wins over OPENROUTER_*.
# NEVER commit a real key. When no key is set the LLM stages degrade gracefully;
# transcription and OCR text still run. Passed to the ai-processor container only.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat

# Legacy names (backward compatible; leave unset when using the LLM_* names).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
